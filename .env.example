# =============================================================================
# LOCAL DEV defaults below. These intentionally DISABLE auth for convenience
# (AUTH_MODE=mock => every request is an implicit store_owner).
#
# PRODUCTION MUST OVERRIDE:
#   JEWELHIRE_STORAGE=postgres
#   AUTH_MODE=google              (or JEWELHIRE_REQUIRE_AUTH=1)
#   AUTH_SECRET=<a long random secret>   (session signing; required)
#   JEWELHIRE_ENABLE_SESSION_OVERRIDE   MUST be unset or 0 (a value of 1 lets
#                                       `x-jewelhire-session: admin` bypass auth)
# Deploying with the mock defaults below leaves the app fully open. See
# lib/server/auth.ts authRequired().
# =============================================================================
JEWELHIRE_STORAGE=local
JEWELHIRE_ENABLE_SESSION_OVERRIDE=0
JEWELHIRE_REQUIRE_AUTH=0
AUTH_MODE=mock
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common
JEWELHIRE_ADMIN_EMAILS=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JewelLink -> JewelHire short-lived authorization-code SSO.
JEWELLINK_URL=http://localhost:3001
# Same high-entropy value configured as JEWELHIRE_SSO_SHARED_SECRET in JewelLink.
JEWELLINK_SSO_SHARED_SECRET=
# Separate server-to-server secret for hire and assessment synchronization.
JEWELLINK_INTEGRATION_SHARED_SECRET=
# Role mapping is fixed in code: Director=store_owner, Manager=assigned locations,
# Student=associate/applicant, ADMIN/SUPER_ADMIN=allowlisted platform admin
# (their upstream company association is not a JewelHire tenant membership).
# Trusted reverse-proxy hops at the right edge of X-Forwarded-For. Local direct
# traffic may leave this blank; production must set and canary-check 0 through 8.
JEWELHIRE_TRUSTED_PROXY_HOPS=
# Production and the Diamond Exchange pilot must set this server-only gate to 0.
# Leave it unset for the legacy local/test fixtures, or set 0 to exercise the paused UI.
# JEWELHIRE_TEAM_INVITES_ENABLED=0
POSTGRES_POOL_MAX=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=system"

# Email. Keep disabled or dry-run until the sender/domain and recipients are verified.
EMAIL_NOTIFICATIONS_ENABLED=false
POSTMARK_DRY_RUN=true
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=notifications@jewelhire.com
POSTMARK_MESSAGE_STREAM=outbound

# Billing and paid store signup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Two recurring USD Stripe Price ids. Their configured unit amounts must be
# exactly $149/month and $1,299/year; server-created Checkout Sessions and the
# signed webhook re-check those amounts before granting standalone access.
STRIPE_STORE_OWNER_MONTHLY_PRICE_ID=
STRIPE_STORE_OWNER_ANNUAL_PRICE_ID=
STRIPE_ALLOW_PROMOTION_CODES=1

# Course media and controlled QA operations.
CLOUDINARY_URL=
QA_RESET_TOKEN=
