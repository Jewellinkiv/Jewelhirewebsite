{
  "name": "jewelhire",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "db:migrate:status": "node scripts/run-migrations.mjs status",
    "db:migrate:apply": "node scripts/run-migrations.mjs apply",
    "db:seed:status": "node scripts/run-seeds.mjs status",
    "db:seed:apply": "node scripts/run-seeds.mjs apply",
    "ops:password-credential": "node scripts/ops-password-credential.mjs",
    "db:readiness": "node scripts/check-database-readiness.mjs",
    "smoke:phase1": "node scripts/smoke-phase1-api.mjs --mode=local",
    "smoke:phase1:postgres": "node scripts/smoke-phase1-api.mjs --mode=postgres",
    "postgres:staging:validate": "node scripts/run-postgres-staging-validation.mjs",
    "qa:browser": "node scripts/browser-smoke-phase1.mjs --start-server --mode=local --port=3003",
    "qa:browser:postgres": "node scripts/browser-smoke-phase1.mjs --start-server --mode=postgres --port=3003",
    "qa:browser:headed": "node scripts/browser-smoke-phase1.mjs --start-server --mode=postgres --port=3003 --headed",
    "qa:frontend-polish": "node scripts/frontend-polish-evidence.mjs",
    "qa:handoff": "node scripts/qa-tester-handoff-audit.mjs",
    "qa:access-control": "node scripts/access-control-audit.mjs",
    "qa:auth": "node scripts/auth-readiness-audit.mjs",
    "qa:billing": "node scripts/billing-readiness-audit.mjs",
    "qa:cross-product": "node scripts/cross-product-acceptance.mjs",
    "qa:config": "node scripts/config-exposure-audit.mjs",
    "qa:invalid-input": "node scripts/invalid-input-audit.mjs",
    "qa:legal": "node scripts/legal-readiness-audit.mjs",
    "qa:jewellink-sso": "node scripts/jewellink-sso-audit.mjs",
    "qa:jewellink-hire": "node scripts/jewellink-hire-audit.mjs",
    "qa:jewellink-jewelcert": "node scripts/jewellink-jewelcert-audit.mjs",
    "qa:jewellink-merge-delta": "node scripts/jewellink-merge-delta-audit.mjs",
    "qa:loop": "node scripts/qa-loop.mjs",
    "qa:manual-smoke-handoff": "node scripts/manual-smoke-handoff-audit.mjs",
    "qa:notifications": "node scripts/notification-readiness-audit.mjs",
    "qa:postmark": "node scripts/postmark-safety-audit.mjs",
    "qa:public-careers": "node scripts/public-careers-audit.mjs",
    "qa:provider-handoff": "node scripts/provider-handoff-audit.mjs",
    "qa:role-model": "node --import tsx scripts/role-model-audit.mjs",
    "qa:roles": "node scripts/role-readiness-audit.mjs",
    "qa:security:live": "node scripts/security-release-audit.mjs",
    "qa:signup-policy": "node scripts/signup-policy-audit.mjs",
    "qa:live": "node scripts/qa-live.mjs",
    "qa:live:headed": "node scripts/qa-live.mjs --headed"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "firebase": "^12.15.0",
    "next": "^16.2.9",
    "pg": "^8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "playwright": "^1.61.1",
    "postcss": "^8.5.10",
    "tailwindcss": "3.4.7",
    "tsx": "^4.23.1",
    "typescript": "5.5.4"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
